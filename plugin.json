{
  "schema_version": 1,
  "id": "video.bilibili",
  "name": "B站视频理解",
  "description": "依据对话语义判断用户是否希望查看视频；结合当前或近期消息中的 B 站链接读取分P、字幕与故事板拼图。",
  "version": "0.1.2",
  "sdk_version": "1",
  "entrypoint": "plugin_adapter:register",
  "license": "MIT",
  "runtime": "worker",
  "dependencies": ["httpx==0.28.1", "Pillow==11.3.0"],
  "tools": ["watch_bilibili"],
  "capabilities": ["network.read", "cache.private", "artifact.image", "events.emit"],
  "network_hosts": ["api.bilibili.com", "i0.hdslb.com", "bimp.hdslb.com", "boss.hdslb.com", "b23.tv", "www.bilibili.com", "m.bilibili.com"],
  "background_tools": ["watch_bilibili"],
  "background_timeout_seconds": 180,
  "config_schema": {
    "type": "object",
    "properties": {
      "frame_count": {"type": "integer", "minimum": 1, "maximum": 12, "default": 6},
      "subtitle_language": {"type": "string", "enum": ["auto", "zh-CN", "en-US"], "default": "auto"}
    },
    "additionalProperties": false
  }
}
